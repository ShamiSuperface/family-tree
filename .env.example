# Copy this file to .env.local (which is git-ignored) to test the email
# reminder locally, and add the same values in Vercel → Settings →
# Environment Variables for the deployed site.

# Your Gmail address, used to send reminder emails.
GMAIL_USER=

# A 16-character Gmail "App Password" (not your regular password).
# Create one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be enabled on the Google account).
GMAIL_APP_PASSWORD=

# Where reminder emails are sent. Defaults to GMAIL_USER if left empty.
REMINDER_EMAIL=

# A random secret string that protects /api/cron/reminders from being
# triggered by anyone else. Vercel automatically sends it when calling
# the cron job once this is set as an environment variable there.
CRON_SECRET=

# Upstash Redis (free tier) — stores guest memories submitted from the
# public "פינת זיכרונות" page. Create a database at https://upstash.com
# (or via Vercel → Storage → Marketplace → Upstash), then copy the REST
# URL and token from its ".env" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
